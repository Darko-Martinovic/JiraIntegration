# Your Atlassian Cloud site; Confluence is read from the same site under /wiki
JIRA_BASE_URL=https://your-site.atlassian.net
# The account the API token belongs to
JIRA_USER_EMAIL=you@example.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# The project the ticket list opens on
JIRA_PROJECT_KEY=KAN
# Optional: seconds to wait for Atlassian before giving up (30 by default)
# JIRA_TIMEOUT_SECONDS=30
